# Domaine public utilisé pour les URLs absolues (canonical, sitemap,
# robots, OpenGraph). Verrouillé en dur ici pour ne pas dépendre de la
# valeur dynamique VERCEL_PROJECT_PRODUCTION_URL, qui ne reflète pas un
# alias custom Vercel (`veille-hackathon` != `site-alpha-gold` nom
# technique du projet).
#
# Si on pose un vrai nom de domaine un jour, changer cette valeur ici
# (ou surcharger via NEXT_PUBLIC_SITE_URL dans les settings Vercel, qui
# prend toujours priorité sur ce fichier).
NEXT_PUBLIC_SITE_URL=https://veille-hackathon.vercel.app
